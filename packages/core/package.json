{
  "name": "@mymore/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./cjs/index.js",
  "module": "./esm/index.js",
  "types": "./cjs/index.d.ts",
  "exports": {
    ".": {
      "import": "./esm/index.js",
      "require": "./cjs/index.js",
      "types": "./cjs/index.d.ts"
    }
  },
  "files": [
    "cjs",
    "esm"
  ],
  "scripts": {
    "build": "father build",
    "dev": "father build --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "father": {
    "esm": {
      "input": "src",
      "output": "esm",
      "platform": "browser"
    },
    "cjs": {
      "input": "src",
      "output": "cjs",
      "platform": "node"
    }
  },
  "dependencies": {
    "better-sqlite3": "13.0.1",
    "gray-matter": "^4.0.3",
    "sqlite-vec": "0.1.9",
    "uuid": "^11.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/uuid": "^10.0.0",
    "father": "^4.5.0"
  }
}
